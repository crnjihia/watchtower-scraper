# =================================================================
# Watchtower Scraper Configuration
# =================================================================

# Storage & Caching
DATABASE_URL=sqlite:///./watchtower.db
REDIS_URL=redis://localhost:6379/0

# Telegram Bot Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Alerting (SendGrid)
SENDGRID_API_KEY=
ALERT_FROM_EMAIL=alerts@watchtower.io
ALERT_TO_EMAILS=alerts-team@watchtower.io,admin@watchtower.io

# Scraper Network & Anti-Bot Protection
# Newline or comma-separated proxy URLs (e.g. http://user:pass@host:port)
PROXIES=
DOWNLOAD_DELAY=2.0
ROBOTSTXT_OBEY=True
AUTOTHROTTLE_ENABLED=True
RANDOMIZE_DOWNLOAD_DELAY=True

# Change Detection & Pruning
MIN_PRICE_DELTA_PCT=1.0
MISSING_AFTER_HOURS=24
RETENTION_DAYS=90

# Observability & HTTP Status API
LOG_LEVEL=INFO
HTTP_PORT=8000
DISPLAY_TIMEZONE=Africa/Nairobi
